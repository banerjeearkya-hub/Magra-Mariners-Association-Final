rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to verify if request is authenticated as one of the authorized officials
    function isAuthorizedOfficial() {
      return request.auth != null &&
             request.auth.token.email != null &&
             (
               request.auth.token.email.lower() == 'sm429113@gmail.com' ||
               request.auth.token.email.lower() == 'ghostygamer47@gmail.com' ||
               request.auth.token.email.lower() == 'arnabinsky@gmail.com'
             );
    }

    // Events Collection: Public can view, only authorized officials can manage
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedOfficial();
    }

    // Gallery Collection: Public can view, only authorized officials can manage
    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedOfficial();
    }

    // Members Collection: Public/Authenticated can register (create) & check status (read), only authorized admins can update/delete
    match /members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthorizedOfficial();
    }

    // Activity & Audit Logs Collection: Strictly Append-Only (Immutable)
    match /activityLogs/{logId} {
      allow read: if isAuthorizedOfficial();
      allow create: if isAuthorizedOfficial();
      allow update, delete: if false; // Append-Only! Logs cannot be modified or deleted
    }

    // Login History Collection: Chronological Session Log
    match /loginHistory/{sessionId} {
      allow read: if isAuthorizedOfficial();
      allow create, update: if isAuthorizedOfficial();
      allow delete: if false;
    }

    // Admin Users Directory (RBAC)
    match /adminUsers/{userId} {
      allow read: if isAuthorizedOfficial();
      allow create, update, delete: if isAuthorizedOfficial();
    }

    // Fallback: Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
